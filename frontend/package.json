{
  "name": "pokecards-frontend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "node": ">=21.0.0",
  "scripts": {
    "setup": "run-s setup:1 setup:2",
    "setup:1": "npm run build:oas",
    "setup:2": "npm i --save-optional ../oas",
    "dev": "vite",
    "clean": "rm -r ../oas dev/ dist/ 2>/dev/null",
    "build": "run-s build:oas build:client",
    "build:oas": "run-s generate:oas build-only:oas",
    "build:client": "run-p type-check:client build-only:client test:unit",
    "preview": "vite preview",
    "test:unit": "vitest --environment jsdom --root src/ --passWithNoTests --run",
    "test:e2e": "start-server-and-test preview :4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' :4173 'cypress open --e2e'",
    "build-only:oas": "cd ../oas && npm i && npm run build",
    "build-only:client": "vite build --outDir dist",
    "generate:oas": "openapi-generator-cli generate",
    "type-check:client": "vue-tsc --noEmit -p tsconfig.vitest.json",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs,.ts,.tsx,.cts,.mts --fix --ignore-path .gitignore"
  },
  "dependencies": {
    "@fortawesome/fontawesome-free": "^6.7.2",
    "@intlify/unplugin-vue-i18n": "^6.0.8",
    "@popperjs/core": "^2.11.8",
    "@vuepic/vue-datepicker": "^11.0.3",
    "bootstrap": "^5.3.8",
    "gravatar": "^1.8.2",
    "mitt": "^3.0.1",
    "moment": "^2.30.1",
    "pinia": "^2.3.1",
    "pinia-class-component": "^0.9.4",
    "vue": "^3.5.42",
    "vue-facing-decorator": "^3.0.4",
    "vue-good-table-next": "^0.2.2",
    "vue-i18n": "^11.4.10",
    "vue-router": "^4.6.4",
    "vue-select": "^4.0.0-beta.6",
    "vue-virtual-scroller": "^2.0.1",
    "vue3-colorpicker": "^2.3.0",
    "vue3-toastify": "^0.2.9"
  },
  "devDependencies": {
    "@openapitools/openapi-generator-cli": "^2.41.0",
    "@rushstack/eslint-patch": "^1.16.1",
    "@tsconfig/node20": "^20.1.10",
    "@types/bootstrap": "^5.2.11",
    "@types/gravatar": "^1.8.6",
    "@types/jsdom": "^21.1.7",
    "@types/vue-select": "^3.16.8",
    "@vitejs/plugin-vue": "^5.2.4",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.7.0",
    "cypress": "^14.5.4",
    "eslint": "^9.39.5",
    "eslint-plugin-cypress": "^4.3.0",
    "eslint-plugin-vue": "^9.33.0",
    "jsdom": "^24.1.3",
    "npm-run-all2": "^7.0.2",
    "prettier": "^3.9.6",
    "sass": "1.79.6",
    "start-server-and-test": "^2.1.5",
    "typescript": "~5.8.2",
    "vite": "^6.4.3",
    "vite-plugin-vue-facing-decorator-hmr": "^1.0.1",
    "vitest": "^3.2.7",
    "vue-tsc": "^2.2.12"
  },
  "devDependenciesNotes": {
    "sass:1.79.6": "needed because bootstrap still uses @import instead of @use; see https://sass-lang.com/blog/import-is-deprecated/"
  },
  "optionalDependencies": {
    "pokecards-oas": "file:../oas"
  },
  "allowScripts": {
    "@openapitools/openapi-generator-cli@2.41.0": true,
    "cypress@14.5.4": true,
    "esbuild@0.25.12": true,
    "file:../../oas": true,
    "@parcel/watcher@2.6.0": true,
    "vue-demi@0.14.10": true
  }
}
