{
  "name": "pokecards-backend",
  "version": "1.0.0",
  "private": true,
  "node": ">=24.0.0",
  "scripts": {
    "dev-win": "set NODE_ENV=development && run-p dev:1 dev:2",
    "dev": "NODE_ENV=development run-p dev:1 dev:2",
    "dev:1": "rm -f dev/main.js && tsc --watch --preserveWatchOutput -p tsconfig.dev.json",
    "dev:2": "wait-on dev/main.js && nodemon -q --watch dev/ dev/main.js",
    "build": "run-s tsoa:spec tsoa:routes type-check build-only test",
    "build-only": "tsc",
    "type-check": "tsc --noEmit --composite false",
    "migrate:make": "knex migrate:make -x ts",
    "run": "node dist/main.js",
    "test": "jest --rootDir src/ --passWithNoTests",
    "tsoa": "run-s tsoa:spec tsoa:routes",
    "tsoa:spec": "npm exec tsoa spec",
    "tsoa:routes": "npm exec tsoa routes"
  },
  "dependencies": {
    "ajv-formats": "^3.0.1",
    "bcrypt": "^6.0.0",
    "compression": "^1.8.2",
    "express": "^4.22.3",
    "express-session": "^1.19.0",
    "filewatcher": "^3.0.1",
    "glob": "^13.0.0",
    "knex": "^3.3.0",
    "mysql2": "^3.24.4",
    "node-schedule": "^2.1.1",
    "objection": "^3.1.5",
    "sqlite3": "^6.0.1",
    "typescript-ioc": "^3.2.2"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@types/bcrypt": "^6.0.0",
    "@types/compression": "^1.8.1",
    "@types/express": "^4.17.25",
    "@types/express-session": "^1.19.0",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^24.0.0",
    "@types/node-schedule": "^2.1.8",
    "jest": "^29.7.0",
    "nodemon": "^3.1.14",
    "npm-run-all2": "^9.0.3",
    "ts-jest": "^29.4.12",
    "tsoa": "^6.6.0",
    "typescript": "^6.0.3",
    "wait-on": "^9.0.0"
  },
  "allowScripts": {
    "bcrypt": true,
    "sqlite3": true
  }
}
